{
  "info": {
    "name": "Team D - Validations & Réunions API",
    "description": "Collection complète des endpoints pour le module Validations & Réunions (Team D - Aymen Settey & Khairi Hammami)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{auth_token}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Meetings",
      "item": [
        {
          "name": "Create Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"plannedDate\": \"2025-12-15T14:00:00Z\",\n  \"agenda\": \"Discussion sur l'avancement du sprint 1 et validation des tâches complétées\",\n  \"referenceType\": \"UserStory\",\n  \"referenceId\": \"{{userstory_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meetings",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings"]
            },
            "description": "Créer une nouvelle réunion (Étudiant uniquement)"
          }
        },
        {
          "name": "Get All Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/meetings?projectId={{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings"],
              "query": [
                {
                  "key": "projectId",
                  "value": "{{project_id}}"
                }
              ]
            },
            "description": "Récupérer toutes les réunions avec filtre optionnel par projet"
          }
        },
        {
          "name": "Get Upcoming Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/meetings/upcoming?projectId={{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "upcoming"],
              "query": [
                {
                  "key": "projectId",
                  "value": "{{project_id}}"
                }
              ]
            },
            "description": "Récupérer les réunions à venir (non complétées)"
          }
        },
        {
          "name": "Get Completed Meetings",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/meetings/completed?projectId={{project_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "completed"],
              "query": [
                {
                  "key": "projectId",
                  "value": "{{project_id}}"
                }
              ]
            },
            "description": "Récupérer les réunions complétées"
          }
        },
        {
          "name": "Get Meeting By ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/meetings/{{meeting_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "{{meeting_id}}"]
            },
            "description": "Récupérer les détails d'une réunion spécifique"
          }
        },
        {
          "name": "Update Meeting",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"plannedDate\": \"2025-12-16T15:00:00Z\",\n  \"agenda\": \"Discussion mise à jour: sprint 1 + revue des blocages\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meetings/{{meeting_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "{{meeting_id}}"]
            },
            "description": "Mettre à jour une réunion non complétée (Étudiant uniquement)"
          }
        },
        {
          "name": "Complete Meeting",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"actualReport\": \"Réunion tenue le 15/12/2025. Points discutés: avancement du sprint 1 (80% complété), 3 tâches validées, 2 blocages identifiés et résolus. Prochaine réunion prévue le 22/12.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meetings/{{meeting_id}}/complete",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "{{meeting_id}}", "complete"]
            },
            "description": "Compléter une réunion avec le compte rendu réel (Étudiant uniquement)"
          }
        },
        {
          "name": "Validate Meeting Content",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isValidated\": true,\n  \"validationComment\": \"Compte rendu complet et détaillé. Bon suivi de l'avancement.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meetings/{{meeting_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "{{meeting_id}}", "validate"]
            },
            "description": "Valider le contenu d'une réunion (Encadrant universitaire uniquement)"
          }
        },
        {
          "name": "Delete Meeting",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/meetings/{{meeting_id}}",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings", "{{meeting_id}}"]
            },
            "description": "Supprimer une réunion (Étudiant uniquement)"
          }
        }
      ]
    },
    {
      "name": "Validations",
      "item": [
        {
          "name": "Validate Task (Without Meeting)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isValid\": true,\n  \"comment\": \"Code bien structuré et testé. Approuvé.\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/validations/tasks/{{task_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "validations", "tasks", "{{task_id}}", "validate"]
            },
            "description": "Valider une tâche hors réunion (Encadrants uniquement)"
          }
        },
        {
          "name": "Validate Task (With Meeting)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"isValid\": true,\n  \"comment\": \"Tâche validée lors de la réunion du 15/12. Bon travail.\",\n  \"meetingId\": \"{{meeting_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/validations/tasks/{{task_id}}/validate",
              "host": ["{{base_url}}"],
              "path": ["api", "validations", "tasks", "{{task_id}}", "validate"]
            },
            "description": "Valider une tâche pendant une réunion (Encadrants uniquement)"
          }
        },
        {
          "name": "Get Task Validations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/validations/tasks/{{task_id}}/validations",
              "host": ["{{base_url}}"],
              "path": ["api", "validations", "tasks", "{{task_id}}", "validations"]
            },
            "description": "Récupérer toutes les validations d'une tâche"
          }
        },
        {
          "name": "Get Meeting Validations",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/validations/meetings/{{meeting_id}}/validations",
              "host": ["{{base_url}}"],
              "path": ["api", "validations", "meetings", "{{meeting_id}}", "validations"]
            },
            "description": "Récupérer toutes les validations liées à une réunion"
          }
        }
      ]
    },
    {
      "name": "Integration Scenarios",
      "item": [
        {
          "name": "Scenario 1: Create Meeting with Task Reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"plannedDate\": \"2025-12-20T10:00:00Z\",\n  \"agenda\": \"Revue de la tâche d'authentification et validation\",\n  \"referenceType\": \"Task\",\n  \"referenceId\": \"{{task_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meetings",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings"]
            },
            "description": "Créer une réunion référençant une tâche spécifique"
          }
        },
        {
          "name": "Scenario 2: Create Meeting with Report Reference",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"projectId\": \"{{project_id}}\",\n  \"plannedDate\": \"2025-12-18T14:00:00Z\",\n  \"agenda\": \"Revue du rapport version 1.0 et feedback\",\n  \"referenceType\": \"Report\",\n  \"referenceId\": \"{{report_id}}\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/meetings",
              "host": ["{{base_url}}"],
              "path": ["api", "meetings"]
            },
            "description": "Créer une réunion référençant une version de rapport"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:5000",
      "type": "string"
    },
    {
      "key": "auth_token",
      "value": "",
      "type": "string"
    },
    {
      "key": "project_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "meeting_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "task_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "userstory_id",
      "value": "",
      "type": "string"
    },
    {
      "key": "report_id",
      "value": "",
      "type": "string"
    }
  ]
}
